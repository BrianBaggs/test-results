# Slack Incoming Webhook URL used by the Publish tab to post test result
# summaries directly to Slack. Create one at:
# https://api.slack.com/messaging/webhooks
#
# Copy this file to .env and fill in your real URL. Restart `npm run dev`
# after changing it.
SLACK_WEBHOOK_URL=SLACK_WEBHOOK_URL_GOES_HERE

# Optional: pre-fills the "Executed By" metadata row on the Publish page
# with this name, so you don't have to retype it on every publish. Must
# keep the VITE_ prefix — this one is read in the browser, not the server.
VITE_EXECUTED_BY=NAME

# --- Review tab (local "pull request"-style review of AT branches) ---------
# Uses the git and Atlassian CLI (acli) already logged in on this machine; no
# tokens are stored here. One-time: run `acli auth login` in a terminal.
#
# Local clone of the repo whose AT-### branches you review.
REVIEW_REPO_PATH=~/Dev/securicy-app
# "Rebase and merge" always lands on playwright-main (not configurable).
# Optional (defaults shown): the AT board column to list, and the status a
# ticket is moved to after merging (only Done or Completed are accepted).
# Jira access is hard-limited to the AT project; nothing else can be touched.
JIRA_REVIEW_STATUS=Review
JIRA_DONE_STATUS=Done
